# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
MAX_UPLOAD_BYTES=104857600

DATABASE_URL=postgresql://tawasol:tawasol@localhost:5432/tawasol
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tawasol
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/tawasol

LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Payments are intentionally disabled until a real provider adapter is configured.
PAYMENT_PROVIDER=
